# Speciality Homeopathy Production Environment Variables
# Copy this to .env.local for local testing, or add directly to Vercel Project Settings

# 1. Primary Website URL (No trailing slash)
NEXT_PUBLIC_SITE_URL=https://specialityhomeopathy.com

# 2. Google Search Console Verification Token
# Obtain from: Google Search Console -> Settings -> Ownership Verification -> HTML Tag method
# Example: abc123def456ghi789
NEXT_PUBLIC_GSC_VERIFICATION=

# 3. Bing Webmaster Tools Verification Token (msvalidate.01)
# Example: 1234567890ABCDEF1234567890ABCDEF
NEXT_PUBLIC_BING_VERIFICATION=

# 4. Google Analytics 4 Measurement ID
# Obtain from: Google Analytics -> Admin -> Data Streams -> Web -> Measurement ID
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
